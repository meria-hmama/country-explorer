# copy this file to .env.local and change the values if you need to.
# both have defaults in the code, so the app also runs without them.

# the countries GraphQL API
NEXT_PUBLIC_COUNTRIES_API_URL=https://countries.trevorblades.com/graphql

# where the site is deployed (used for canonical links, sitemap.xml and social previews)
NEXT_PUBLIC_SITE_URL=https://country-explorer-wheat-phi.vercel.app
